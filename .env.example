# trend-hunter — example environment file
# Copy to .env and fill in the values you actually use. NEVER commit .env.
#
# All values are optional. The tool works zero-config on a fresh laptop.

# ── database ─────────────────────────────────────────────────────────────
TH_DB_PATH=./data/trends.duckdb

# ── logging ──────────────────────────────────────────────────────────────
TH_LOG_LEVEL=INFO
TH_LOG_DIR=./data/logs

# ── scheduler ────────────────────────────────────────────────────────────
TH_SCAN_INTERVAL_MINUTES=120
TH_AGGREGATE_HOUR=3

# ── dashboard ────────────────────────────────────────────────────────────
TH_DASH_PORT=8501

# ── alerts (all optional) ────────────────────────────────────────────────
# Discord webhook URL (https://discord.com/api/webhooks/...)
# TH_DISCORD_WEBHOOK=

# Telegram bot token + chat_id
# TH_TELEGRAM_BOT_TOKEN=
# TH_TELEGRAM_CHAT_ID=

# ── outbound mail (optional) ─────────────────────────────────────────────
# Gmail SMTP using App Password (https://myaccount.google.com/apppasswords)
# TH_GMAIL_ADDRESS=
# TH_GMAIL_APP_PASSWORD=

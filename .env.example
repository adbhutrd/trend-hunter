# trend-hunter — environment variables
# Copy this file to .env and fill in the blanks:
#   cp .env.example .env
#
# Everything is optional — the tool works fine with defaults.
# Only configure what you actually want to use.

# ── Storage ───────────────────────────────────────────────────────────────────
# Where the DuckDB file lives (default: ./data/trends.duckdb)
# TH_DB_PATH=./data/trends.duckdb

# ── Logging ───────────────────────────────────────────────────────────────────
# TH_LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR
# TH_LOG_DIR=./data/logs

# ── Dashboard ─────────────────────────────────────────────────────────────────
# TH_DASH_PORT=8501          # Streamlit listens here

# ── Scheduling ────────────────────────────────────────────────────────────────
# TH_SCAN_INTERVAL_MINUTES=120
# TH_AGGREGATE_HOUR=3

# ── Discord alerts ────────────────────────────────────────────────────────────
# 1. Open Discord → pick your server → Server Settings → Integrations → Webhooks
# 2. Click "New Webhook" → name it "trend-hunter" → pick a channel → Copy URL
# 3. Paste the URL below (it starts with https://discord.com/api/webhooks/)
TH_DISCORD_WEBHOOK=

# ── Telegram alerts (alternative, works alongside Discord) ─────────────────────
# 1. Open Telegram → DM @BotFather → /newbot → name it → get bot token
# 2. DM your new bot, then visit: https://api.telegram.org/bot<TOKEN>/getUpdates
# 3. Copy your chat_id from the JSON response
# TH_TELEGRAM_BOT_TOKEN=
# TH_TELEGRAM_CHAT_ID=

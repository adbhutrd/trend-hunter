[Unit]
Description=trend-hunter auto-scheduler (scan → classify → aggregate → ML forecast every 30 min)
Documentation=https://github.com/your-org/trend-hunter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/trend-hunter/.venv/bin/python -m trend_hunter.flows.daily
WorkingDirectory=%h/trend-hunter
Restart=on-failure
RestartSec=30
StandardOutput=append:%h/trend-hunter/data/logs/scheduler-service.log
StandardError=append:%h/trend-hunter/data/logs/scheduler-service.log
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
